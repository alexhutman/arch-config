#!/usr/bin/env bash

DELTA=5

error_msg() {
    echo $@ >&2
}

usage() {
	error_msg "Usage:
  $0
Options:
  -i, increase brightness by DELTA (default: $DELTA)
  -d, decrease brightness by DELTA (default: $DELTA)"
}

set_dbright() {
	[ -n "$DBRIGHT" ] && error_msg "Must supply either -i OR -d" && usage && exit 1
	DBRIGHT="$1"
}

while getopts ":id" opt; do
	case $opt in
		i)
			set_dbright $DELTA
			;;
		d)
			set_dbright "-$DELTA"
			;;
		\?)
			error_msg "Invalid option: -$OPTARG"
			usage
			exit 1
			;;
	esac
done

BACKLIGHT_DIR="/sys/class/backlight"
NUM_BACKLIGHTS="$(ls -A "$BACKLIGHT_DIR" | wc -l)"
if [ $NUM_BACKLIGHTS -eq 0 ]; then
   error_msg "No backlights detected."
   exit 1
elif [ $NUM_BACKLIGHTS -gt 1 ]; then
   error_msg "Multiple backlights detected."
   exit 1
fi

# Exit if not called with i or d flag
[ -z "$DBRIGHT" ] && usage && exit 1

BACKLIGHT_FILE="$(ls $BACKLIGHT_DIR/*/brightness)"
[ ! -f "$BACKLIGHT_FILE" ] && error_msg "Your backlight is missing a brightness file" && exit 1

# Get current brightness
# TODO: Probably have to change this if on a different setup but that's a problem for later
CUR_BRIGHTNESS="$(cat $BACKLIGHT_FILE)"

# Offset current brightness by DBRIGHT
NEW_BRIGHTNESS=$((CUR_BRIGHTNESS+$DBRIGHT))
echo $NEW_BRIGHTNESS > $BACKLIGHT_FILE
